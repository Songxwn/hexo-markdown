{
  "name": "hexo-markdown",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "description": "跨平台 Hexo Markdown 编辑器：实时预览，粘贴图片自动上传 Cloudflare R2",
  "author": "Hexo Markdown",
  "repository": {
    "type": "git",
    "url": "https://github.com/Songxwn/hexo-markdown.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "electron .",
    "dist": "vite build && electron-builder --publish never",
    "dist:win": "vite build && electron-builder --win --publish never",
    "dist:mac": "vite build && electron-builder --mac --publish never",
    "dist:linux": "vite build && electron-builder --linux --publish never"
  },
  "engines": {
    "node": ">=18"
  },
  "build": {
    "appId": "app.hexo.markdown",
    "productName": "Hexo Markdown",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "asar": true,
    "extraMetadata": {
      "main": "dist-electron/main.js",
      "type": "module"
    },
    "asarUnpack": [
      "**/*.node",
      "node_modules/ssh2/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Office",
      "maintainer": "Hexo Markdown"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "Songxwn",
      "repo": "hexo-markdown",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "gray-matter": "^4.0.3",
    "nanoid": "^5.1.5",
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/language": "^6.11.3",
    "@codemirror/language-data": "^6.5.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.1",
    "@lezer/highlight": "^1.2.1",
    "@types/node": "^24.2.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "^5.0.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.2.6",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.539.0",
    "marked": "^16.1.2",
    "marked-highlight": "^2.2.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
