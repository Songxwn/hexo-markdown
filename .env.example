# Hexo 博客根目录（含 _config.yml）
HEXO_ROOT=F:\path\to\your\hexo-blog

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# 对外访问前缀，不要末尾斜杠。自定义域名或 r2.dev 均可
# 例: https://img.example.com  或  https://pub-xxxx.r2.dev
R2_PUBLIC_URL=
# 对象键前缀，默认 hexo
R2_KEY_PREFIX=hexo

# SSH / SFTP（也可在应用设置中填写）
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_PASSWORD=
SSH_PRIVATE_KEY=
SSH_PASSPHRASE=
REMOTE_HEXO_ROOT=/home/ubuntu/blog
SSH_GENERATE_CMD=npx hexo generate
SSH_DEPLOY_CMD=npx hexo deploy

# 界面皮肤：ink（墨色）/ paper（宣纸）/ midnight（夜航）/ celadon（青瓷）
# THEME=ink

